---
// Renders an empty <nav> that is populated client-side from h2/h3 elements in <main>.
// Place directly after <h1> on any page. Hides itself if no headings are found.
---

<nav id="toc" aria-label="Table of contents"></nav>

<script>
    (function () {
        const nav = document.getElementById("toc");
        const main = document.querySelector("main");
        if (!nav || !main) return;

        // Typed as headings rather than left as Element. A comma selector is
        // not one of the tag names TypeScript knows how to narrow, so without
        // this the list comes back as plain Elements and setting .style on one
        // does not type check.
        const headings = Array.from(main.querySelectorAll<HTMLHeadingElement>("h2, h3"));
        if (headings.length === 0) { nav.remove(); return; }

        const headerHeight = document.querySelector("header")?.offsetHeight ?? 0;

        const used = new Map<string, number>();
        const slugify = (text: string) =>
            text.toLowerCase().trim()
                .replace(/[^\w\s-]/g, "")
                .replace(/\s+/g, "-")
                .replace(/-+/g, "-");

        headings.forEach((h) => {
            if (!h.id) {
                let base = slugify(h.textContent ?? "");
                if (!base) base = h.tagName.toLowerCase();
                const count = used.get(base) ?? 0;
                h.id = count === 0 ? base : `${base}-${count}`;
                used.set(base, count + 1);
            }
            h.style.scrollMarginTop = (headerHeight + 16) + "px";
        });

        const label = document.createElement("p");
        label.className = "toc-label";
        label.textContent = "Contents";

        const ol = document.createElement("ol");
        ol.className = "toc-list";

        headings.forEach((h) => {
            const li = document.createElement("li");
            li.className = h.tagName === "H3" ? "toc-item toc-item--h3" : "toc-item";
            const a = document.createElement("a");
            a.href = "#" + h.id;
            a.textContent = h.textContent ?? "";
            a.addEventListener("click", (e) => {
                e.preventDefault();
                h.scrollIntoView({ behavior: "smooth", block: "start" });
            });
            li.appendChild(a);
            ol.appendChild(li);
        });

        nav.appendChild(label);
        nav.appendChild(ol);
    })();
</script>
